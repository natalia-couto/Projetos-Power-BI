	measure '88 Cross Número de Vendas' = ```
			
			
			var TbVendas = Values(fVendas[idNota])
			
			var TbVendasAux = CALCULATETABLE(VALUES(fVendas[idNota]),ALL(dProduto), USERELATIONSHIP(fVendas[Produto], 'Aux Produto'[IdProduto]))
			
			var TbInter = INTERSECT(TbVendas, TbVendasAux)
			
			var vResultado = COUNTROWS(TbInter)
			
			RETURN
			
			IF(SELECTEDVALUE(dProduto[Sub-Categoria]) <> SELECTEDVALUE('Aux Produto'[Sub-Categoria]), vResultado, BLANK())
			
			
			
			```
		formatString: 0
		lineageTag: f188df8a-acc3-4b39-bc91-8e648a6307a1

